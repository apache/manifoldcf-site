interface Props {
  id: string;
  code: string;
  label?: string;
  copyLabel: string;
}

const { id, code, label, copyLabel } = Astro.props;
---

<div class="code-panel">
  {label && <div class="code-panel-header"><span>{label}</span></div>}
  <div class="copyable">
    <span class="copy">
      <button
        type="button"
        class="copy-button"
        {...({ command: '--copy', commandfor: id } as Record<string, string>)}
        aria-label={copyLabel}
      >
        <span class="copy-icon" aria-hidden="true"></span>
      </button>
      <span class="tip" role="status"></span>
    </span>
    <pre tabindex="0"><code id={id}>{code}</code></pre>
  </div>
</div>
