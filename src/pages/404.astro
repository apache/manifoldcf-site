import BaseLayout from '../layouts/BaseLayout.astro';
import { WIKI_BASE } from '../data/site';
import { withBase } from '../utils/url';
---

<BaseLayout title="Page Not Found | Apache ManifoldCF™">
  <section class="section">
    <div class="container" style="text-align: center; padding-block: 3rem;">
      <span class="badge badge-apache">404 · Not Found</span>
      <h1 id="main-content" tabindex="-1" style="margin-block-start: 0.75rem;">
        This page has moved or does not exist
      </h1>
      <p style="max-inline-size: 56ch; margin-inline: auto; color: var(--color-text-secondary);">
        Technical manuals, connector guides, and developer documentation now live on the
        official Apache ManifoldCF GitHub Wiki.
      </p>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-block-start: 1.5rem;">
        <a class="btn btn-primary" href={withBase('/')}>Go to Home</a>
        <a class="btn btn-secondary" href={withBase('/downloads/')}>Downloads</a>
        <a class="btn btn-secondary" href={WIKI_BASE} target="_blank" rel="noopener noreferrer">
          Browse GitHub Wiki
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
